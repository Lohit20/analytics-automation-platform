<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.fxreport</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/analytics-automation-platform/.venv/bin/python</string>
        <string>/path/to/analytics-automation-platform/run_report.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/analytics-automation-platform</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/analytics-automation-platform/data/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/analytics-automation-platform/data/launchd_stderr.log</string>
</dict>
</plist>
